# Dependências e builds
node_modules/
.expo/
dist/
build/

# Ambiente
.env
.env.*

# Dados brutos pesados (doc seção 4: "não versionar o que for pesado")
data/raw/*
!data/raw/README.md
# Feed gerado pesa dezenas de MB; versionamos só o relatório da geração
data/gtfs/*
!data/gtfs/_RELATORIO.md
# Metadados oficiais por linha (operadora/tipo/km do geojson da SEMOB): pequenos
# e são entrada do gerador — sem eles o feed cai para agência única.
!data/gtfs/_SEMOB_METADADOS.json
# Auditoria de traçados contra o GeoJSON oficial da SEMOB
!data/gtfs/_AUDITORIA_SHAPES.md

# Logs e SO
*.log
.DS_Store
Thumbs.db

# relatórios de diagnóstico de permissões (sessão local)
.acl-recovery/
# Sondagens arquivadas (higiene 2026-10-29): histórico de investigação fora do repo
tools/scraper/_sondagem/
# mini-banco temporário do pytest (recriado a cada execução)
tools/scraper/pytest-of-Usuario/
# pacote de dados do app (58 MB; gerado pelo CLI + sync-db)
apps/mobile/assets/flavos.sqlite
# export de validação local do bundler
apps/mobile/.expo-export-test/
apps/mobile/.expo-export-native/
apps/mobile/.expo-export-android/
# artefatos de diagnóstico da sessão de testes (mapa de ids, logs)
apps/mobile/.tmp/
tools/scraper/.tmp/
# skills de terceiros instaladas localmente + artefatos de medição de marca
# (o lockfile skills-lock.json É versionado; o conteúdo de .claude não)
.claude/
